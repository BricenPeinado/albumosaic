# Required for Spotify playlist metadata through Authorization Code with PKCE.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/spotify/callback

# Required to identify Albumosaic to the MusicBrainz Web Service.
MUSICBRAINZ_CONTACT=you@example.com

# Optional local-first artwork manifest.
# ALBUMOSAIC_ARTWORK_MANIFEST=/absolute/path/to/artwork-manifest.json
